{
  "manifest_version": 3,
  "name": "VDM — capture de vidéos",
  "version": "0.2.0",
  "description": "Détecte les vidéos des pages et les envoie au gestionnaire de téléchargements VDM.",
  "permissions": ["webRequest", "contextMenus", "storage", "tabs", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "VDM" }
}
